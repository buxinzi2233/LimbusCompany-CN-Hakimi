      "texts": [
        {
          "index": 0,
          "text": "坐到椅子上吧，小宝贝。",
          "speaker": "让娜"
        },
        {
          "index": 1,
          "text": "至今为止你一次都没能坐下过不是吗？",
          "speaker": "让娜"
