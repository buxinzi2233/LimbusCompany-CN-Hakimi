{
  "dataList": [
    {
      "key": "D3543",
      "texts": [
        {
          "index": 0,
          "text": "各种事物的残骸混杂在一起。大多是那些随潮流漂流的褐派留下的衣服。"
        }
      ]
    },
    {
      "key": "D3582",
      "texts": [
        {
          "index": 0,
          "text": "刀刃变钝的剪刀，仿佛剪断事物的渴望已彻底冷却。"
        }
      ]
    },
    {
      "key": "D3581",
      "texts": [
        {
          "index": 0,
          "text": "线轴依旧保管得很好。"
        }
      ]
    },
    {
      "key": "D3572",
      "texts": [
        {
          "index": 0,
          "text": "金色与红色都已褪去，只剩下劣质的皮革。"
        }
      ]
    },
    {
      "key": "D3517",
      "texts": [
        {
          "index": 0,
          "text": "挂着的皮革大多已被撕掉。能看到像是牙印的痕迹。"
        }
      ]
    },
    {
      "key": "D3520",
      "texts": [
        {
          "index": 0,
          "text": "陈列柜之间，能看到依旧保存完好的衣服。"
        }
      ]
    },
    {
      "key": "D3563",
      "texts": [
        {
          "index": 0,
          "text": "黑派的人台。是百货公司里的人台，还是外面的人台？如今，区分这些似乎已毫无意义。"
        }
      ]
    },
    {
      "key": "D3560",
      "texts": [
        {
          "index": 0,
          "text": "衣服蒙上了一层灰尘。泛着金光的线，一根都不剩了。"
        }
      ]
    },
    {
      "key": "D3557",
      "texts": [
        {
          "index": 0,
          "text": "断裂的缝隙间粘着骨片与碎肉。"
        }
      ]
    },
    {
      "key": "D3555",
      "texts": [
        {
          "index": 0,
          "text": "乍看完好无损，但用黄金松脂缝合的地方都已被撕开。"
        }
      ]
    },
    {
      "key": "D3550",
      "texts": [
        {
          "index": 0,
          "text": "能感觉到管道微弱的振动。把头凑近管道，便能听到里面回响的声音。"
        },
        {
          "index": 1,
          "text": "[遵从秩序……行事啊啊……]"
        },
        {
          "index": 2,
          "text": "[我记得……那痛苦啊啊……]"
        }
      ]
    },
    {
      "key": "D3551",
      "texts": [
        {
          "index": 0,
          "text": "旧日的声音无法离去，在原地徘徊。"
        }
      ]
    },
    {
      "key": "D3544",
      "texts": [
        {
          "index": 0,
          "text": "损坏的管道前堆着磁带。翻找时，黑派店内时常响起的声音被拖得很长，播放片刻便断了。"
        }
      ]
    },
    {
      "key": "D3539",
      "texts": [
        {
          "index": 0,
          "text": "陈旧的骰子。漫长岁月里，似乎从未有人掷过它。"
        }
      ]
    },
    {
      "key": "D3529",
      "texts": [
        {
          "index": 0,
          "text": "被人故意砸坏的排风扇。原本塞满里面的灰尘已消失得干干净净。"
        }
      ]
    },
    {
      "key": "D3536",
      "texts": [
        {
          "index": 0,
          "text": "曾经传递声音的管道像线一样缠成一团。"
        }
      ]
    },
    {
      "key": "D3530",
      "texts": [
        {
          "index": 0,
          "text": "排风扇正在运转。感觉周围的空气似乎清新了些。"
        }
      ]
    },
    {
      "key": "D3527",
      "texts": [
        {
          "index": 0,
          "text": "倒塌的台子之间，能看到黑派的鉴定报告。"
        },
        {
          "index": 1,
          "text": "[致3层楼层经理。]"
        },
        {
          "index": 2,
          "text": "[如今，“声音”大人因故不在，黑派迫切需要您的广播。]"
        },
        {
          "index": 3,
          "text": "[在连可供追随的潮流都消失之前，恳请您来到黑派。]"
        },
        {
          "index": 4,
          "text": "……人已经不在这里了，是投向黑派了吗？",
          "speaker": "辛克莱"
        },
        {
          "index": 5,
          "text": "也可能恰恰相反。不能排除因为没有转投黑派而遭到惩罚的可能。",
          "speaker": "奥提斯"
        },
        {
          "index": 6,
          "text": "无论哪种情况，应该都选择了其中一方。不可能始终坚持中立立场。",
          "speaker": "奥提斯"
        }
      ]
    },
    {
      "key": "D3528",
      "texts": [
        {
          "index": 0,
          "text": "这里留下了黑派的鉴定报告。地上散落着三四份，似乎不止送过一次。"
        }
      ]
    },
    {
      "key": "D3525",
      "texts": [
        {
          "index": 0,
          "text": "倒塌的柱子。这种高度，似乎可以跳过去……"
        },
        {
          "index": 1,
          "text": "<默尔索，不能直接跳过去吗？>",
          "speaker": "但丁"
        },
        {
          "index": 2,
          "text": "……我会尝试。",
          "speaker": "默尔索"
        },
        {
          "index": 3,
          "text": "默尔索活动了一下身体，用力跃起，试图跳过柱子……"
        },
        {
          "index": 4,
          "text": "却像被什么绊住了，直直地栽倒在地。"
        },
        {
          "index": 5,
          "text": "<……对不起。>",
          "speaker": "但丁"
        },
        {
          "index": 6,
          "text": "默尔索像是并不在意，拍了拍衣服，又站了起来。"
        }
      ]
    },
    {
      "key": "D3526",
      "texts": [
        {
          "index": 0,
          "text": "倒塌的柱子。连默尔索也没能跳过去。"
        }
      ]
    },
    {
      "key": "D3521",
      "texts": [
        {
          "index": 0,
          "text": "里面装满了曾经是……眼球的东西。已经腐烂溃坏，似乎不能用了。"
        }
      ]
    },
    {
      "key": "D3505",
      "texts": [
        {
          "index": 0,
          "text": "沙发没有发出任何声音。"
        }
      ]
    },
    {
      "key": "D3516",
      "texts": [
        {
          "index": 0,
          "text": "这根柱子似乎并非因岁月流逝而倒塌，而是被人故意推倒的。"
        }
      ]
    },
    {
      "key": "D3506",
      "texts": [
        {
          "index": 0,
          "text": "死鸟和拖长的磁带散落了一地。"
        }
      ]
    },
    {
      "key": "D3504",
      "texts": [
        {
          "index": 0,
          "text": "皮革全被撕掉的装饰品。"
        }
      ]
    },
    {
      "key": "D3503",
      "texts": [
        {
          "index": 0,
          "text": "修补师的剪刀。虽然历经漫长岁月，刀刃已经变钝，却似乎仍能剪断什么。"
        }
      ]
    }
  ]
}
